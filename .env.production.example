# 生产环境配置（复制为 .env 并修改）
DJANGO_ENV=production

# 必须替换成随机生成的密钥（python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"）
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long

# 允许访问的域名，多个用逗号分隔
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,服务器IP

# 生产环境必须关闭
DEBUG=False

# 调试日志关闭
DEBUG_LOG_API=False

# 通知开关
ENABLE_NOTIFICATIONS=True

# SMTP 邮件配置
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-mailbox@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-app-password
DEFAULT_FROM_EMAIL=Ziqiang Academy <your-mailbox@example.com>

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_EMAIL=admin@example.com

# CORS 允许的前端域名
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# CSRF 信任的域名
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# PostgreSQL 14+；先创建数据库和专用用户
DB_ENGINE=postgresql
DB_NAME=ziqiang
DB_USER=ziqiang
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
SECURE_HSTS_SECONDS=3600
